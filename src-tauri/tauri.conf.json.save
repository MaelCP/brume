{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mon-overlay-claude",
  "version": "0.1.0",
  "identifier": "com.satoshi.mon-overlay-claude",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mon-overlay-claude",
        "width": 800,
        "height": 600
      }{
  "app": {
    "windows": [
      {
        "title": "ClaudeHUD",
        "width": 640,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      	}
    	]
  	}
	}
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
